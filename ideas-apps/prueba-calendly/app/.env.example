# Copia a .env.local y rellena TU. Claude nunca crea cuentas ni escribe claves reales.
# Base de datos (Supabase o Neon)
DATABASE_URL=
# Supabase Auth (pendiente de conectar)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Email (Resend). Sin clave se usa un proveedor simulado que no envia nada.
RESEND_API_KEY=
# Calendarios: apps OAuth propias de Google Cloud y Microsoft Entra (pendiente)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# Cifrado de tokens de calendario (32 bytes en base64)
TOKEN_ENCRYPTION_KEY=
# Stripe (solo si se activan cobros; empezar en modo test)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Limite de reservas por IP y minuto (por defecto 10)
RATE_BOOK=
